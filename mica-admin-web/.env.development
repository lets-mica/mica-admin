VITE_APP_TITLE=MICA-ADMIN
VITE_APP_NAMESPACE=mica-admin
VITE_APP_STORE_SECURE_KEY=mica-admin-store-key
VITE_PORT=5888
VITE_BASE=/
VITE_GLOB_API_URL=/api
VITE_ROUTER_HISTORY=web
VITE_INJECT_APP_LOADING=true
VITE_DEVTOOLS=true
# 后端服务地址（vite dev server /api 代理目标）
VITE_PROXY_TARGET=http://localhost:18080
# 接口文档地址（Knife4j）
VITE_GLOB_SWAGGER_URL=http://localhost:18080/doc.html
# IM MQTT WebSocket 地址（mica-mqtt 内嵌 broker 的 WS 端口默认 8083）
# dev 用当前主机名直连 WS（不走 vite 代理），保持与后端同源
VITE_MQTT_WS_URL=ws://localhost:8083/mqtt
