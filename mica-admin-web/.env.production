VITE_APP_TITLE=MICA-ADMIN
VITE_APP_NAMESPACE=mica-admin
VITE_APP_STORE_SECURE_KEY=mica-admin-store-key
VITE_BASE=/
VITE_GLOB_API_URL=/api
VITE_ROUTER_HISTORY=hash
VITE_INJECT_APP_LOADING=true
VITE_DEVTOOLS=false
# 接口文档地址（Knife4j）
VITE_GLOB_SWAGGER_URL=http://localhost:18080/doc.html
# IM MQTT WebSocket 地址（生产环境走 wss，与 mica-mqtt 的 SSL 配置配合）
# 部署时按实际域名修改
VITE_MQTT_WS_URL=wss://your-domain.com/mqtt
