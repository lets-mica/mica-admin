# 锁版本：依赖 catalog 后，所有包共用一份声明，避免出现两份同包不同版本。
prefer-frozen-lockfile=true
save-workspace-protocol=rolling

# catalog 推荐搭配：禁用 phantom peer 警告噪音，必要时由 catalog 强制统一。
strict-peer-dependencies=false
auto-install-peers=true
resolve-peers-from-workspace=true

# 跳过 postinstall 里的本地构建，配合 pnpm-workspace.yaml 中的 allowBuilds。
side-effects-cache=true

# registry：可按需替换为内网镜像（如淘宝）。
# registry=https://registry.npmmirror.com/
